{
  "name": "siyuan-zotero-toolbar",
  "version": "0.1.1",
  "description": "Zotero-style annotation toolbar for SiYuan documents",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && node scripts/copy-assets.mjs",
    "deploy": "node scripts/copy-assets.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "harness": "vite --port 5199",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e/annotate.mjs"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "zotero",
    "annotation",
    "sticky-note",
    "draw"
  ],
  "license": "MIT",
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "modern-screenshot": "^4.7.0",
    "perfect-freehand": "^1.2.2",
    "siyuan": "^1.0.8"
  }
}
